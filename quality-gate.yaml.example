# Quality Gate 配置文件

# 启用的语言——check/scan 只运行这里声明的语言（A 包语义）：
# 纯 Python 项目写 python 即可，不会尝试 clippy/oxlint（也不因缺工具误红）。
# 显式 --lang 覆盖本配置；--lang all 强制全语言。
# 别名: typescript = ts（其余语言名直接用小写语言名）
languages:
  - rust
  - typescript
  - python

# 阈值配置
thresholds:
  # CRAP/圈复杂度阈值（P1 已接线，2026-09）：check --diff 对 Python 新增
  # def 且 cc ≥ 该值的函数阻塞（函数体 ≥5 行、function_ignore 豁免除外）
  crap: 30
  # 圈复杂度阈值
  cyclomatic_complexity: 15
  # 重复代码百分比阈值（新增重复行 / 新增总行）
  duplication: 3
  # jscpd 最小 token 数
  min_tokens: 50
  # jscpd 最小行数
  min_lines: 5

# 覆盖率忽略路径（glob 模式）
coverage_ignore:
  paths:
    - "**/models.py"
    - "**/schemas.py"
    - "**/constants.py"
    - "**/migrations/**"
    - "**/*.d.ts"
    - "**/generated/**"

# Lint 忽略路径
lint_ignore:
  paths:
    - "**/generated/**"
    - "**/node_modules/**"
    - "**/target/**"
    - "**/.venv/**"
    - "**/venv/**"
    - "**/dist/**"
    - "**/build/**"
    - ".quality-gate/**"   # quality-gate 自身产物（scan 存档）

# 函数级豁免（C2 已接线；P1 扩展到 CRAP 阻塞）：长而聚焦的函数按名挂账，
# 豁免其 long-method / long-parameter-list 上报，以及 Python CRAP 阻塞。
# 纯函数名匹配——多文件同名会全豁免；确实需要豁免的函数名才写，别当摆设。
function_ignore:
  - "long_legacy_fn"

# 结构坏味道（smell，Python AST 规则引擎）
# 键名 = SmellConfig 字段；省略的项用引擎内置默认（60 行/10 方法/300 行/5 参数/3 分支/2 方法）
smell:
  # 函数体超过该行数 → long-method（P0，阻塞）
  max_function_lines: 60
  # 类方法数 / 类行数超限 → large-class（P1，阻塞）
  max_class_methods: 10
  max_class_lines: 300
  # 参数超过该数 → long-parameter-list（P1，阻塞）
  max_parameters: 5
  # match/case 分支超过该数 → switch-statements（P2，仅报告）
  max_switch_branches: 3
  # 方法数不超过该值的类 → lazy-class（P2，仅报告）
  min_lazy_class_methods: 2
  # 只运行指定规则（不写 = 全部启用）；例: ["long-method", "dead-import"]
  enabled_rules: []
  # 排除指定规则（不写 = 不排除）；例: ["data-class"]
  disabled_rules: []
  # smell 专属豁免路径（B1，2026-09-05 语义解耦）——与 lint_ignore 互不污染：
  #   lint 豁免不该管 smell；故意样本/测试桩（按设计要触发规则的 fixtures）
  #   用本通道显式豁免，checker 层按路径跳过
  # 生效集合 = lint_ignore.paths ∪ smell.ignore.paths（并集，向后兼容）
  ignore:
    paths:
      - "tests/smell/fixtures/**"
